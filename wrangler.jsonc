{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tailbound-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tailbound-landing"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "tailbound.xyz/*",
      "zone_id": "21ba1c5d3bb642ee2b1a541514a85de9"
    }
  ]
}
