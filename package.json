{
  "name": "tailbound-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.mts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:verify": "node scripts/cloudflare-verify.mjs",
    "cf:smoke": "node scripts/cloudflare-verify.mjs --origin https://tailbound.xyz",
    "cf:deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "next": "16.3.8",
    "next-intl": "^4.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.2",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "unrs-resolver",
      "@swc/core",
      "@parcel/watcher"
    ]
  },
  "type": "module"
}
